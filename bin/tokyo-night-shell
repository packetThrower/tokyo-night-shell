#!/usr/bin/env bash
# tokyo-night-shell — coordinated Tokyo Night theme for WezTerm, Starship,
# Zellij. Single CLI with three subcommands: init, uninstall, swap.
# https://github.com/packetThrower/tokyo-night-shell
set -euo pipefail

VERSION="0.1.0"

# ─── Locate resources ────────────────────────────────────────────────────────
# Source configs (wezterm.lua, starship.toml, zellij themes, shell hook) live
# in two layouts:
#   - Git clone:   under <repo>/        (this script is at <repo>/bin/)
#   - Homebrew:    under <prefix>/share/tokyo-night-shell/
# `TOKYO_NIGHT_SHELL_RESOURCES` env var overrides both, for testing.
_locate_resources() {
  if [[ -n "${TOKYO_NIGHT_SHELL_RESOURCES:-}" ]]; then
    echo "$TOKYO_NIGHT_SHELL_RESOURCES"
    return
  fi
  local real parent
  real="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
  parent="$(dirname "$real")"
  if   [[ -d "$parent/share/tokyo-night-shell" ]]; then
    echo "$parent/share/tokyo-night-shell"
  elif [[ -f "$parent/wezterm/wezterm.lua" ]]; then
    echo "$parent"
  else
    printf "Cannot locate tokyo-night-shell source files.\n" >&2
    printf "Set TOKYO_NIGHT_SHELL_RESOURCES, or run from a recognized layout.\n" >&2
    exit 1
  fi
}
RESOURCES="$(_locate_resources)"
in_git_clone() { [[ -d "$RESOURCES/.git" ]]; }

# ─── State ───────────────────────────────────────────────────────────────────
TIMESTAMP="$(date +%Y%m%d-%H%M%S)"
MARKER_BEGIN="# >>> tokyo-night-shell init >>>"
MARKER_END="# <<< tokyo-night-shell init <<<"
ZSHRC="${ZDOTDIR:-$HOME}/.zshrc"

# ─── Pretty printers ─────────────────────────────────────────────────────────
info() { printf "  \033[1;34m›\033[0m %s\n" "$*"; }
ok()   { printf "  \033[1;32m✓\033[0m %s\n" "$*"; }
warn() { printf "  \033[1;33m!\033[0m %s\n" "$*"; }
fail() { printf "  \033[1;31m✗\033[0m %s\n" "$*" >&2; exit 1; }

# ─── Helpers ─────────────────────────────────────────────────────────────────
is_macos() { [[ "$(uname -s)" == "Darwin" ]]; }
_mode()    { stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1"; }

backup_if_exists() {
  local f="$1"
  if [[ -e "$f" && ! -L "$f" ]]; then
    cp -p "$f" "${f}.bak.${TIMESTAMP}"
    info "Backed up ${f/#$HOME/~} → ${f/#$HOME/~}.bak.${TIMESTAMP}"
  fi
}

restore_latest_backup() {
  local target="$1" latest
  latest=$(ls -1t "${target}".bak.* 2>/dev/null | head -1 || true)
  if [[ -n "$latest" ]]; then
    cp -p "$latest" "$target"
    ok "Restored ${target/#$HOME/~} from ${latest/#$HOME/~}"
  else
    warn "No backup found for ${target/#$HOME/~} — leaving current file in place."
  fi
}

# ─── cmd: init ───────────────────────────────────────────────────────────────
cmd_init() {
  is_macos || warn "Not macOS — light/dark auto-switch will stay on the day palette."

  # Brew-installed deps. In a brew install of tokyo-night-shell these are
  # already present via `depends_on`; in a git-clone install they may not be.
  local need_brew=false
  command -v wezterm  >/dev/null 2>&1 || need_brew=true
  command -v starship >/dev/null 2>&1 || need_brew=true
  if $need_brew; then
    command -v brew >/dev/null 2>&1 \
      || fail "Homebrew not found. Install from https://brew.sh, then re-run."
  fi
  if ! command -v wezterm >/dev/null 2>&1; then
    info "Installing WezTerm via Homebrew..."
    brew install --cask wezterm
  fi
  ok "WezTerm: $(wezterm --version | head -1)"
  if ! command -v starship >/dev/null 2>&1; then
    info "Installing Starship via Homebrew..."
    brew install starship
  fi
  ok "Starship: $(starship --version | head -1)"

  # Font
  if is_macos && command -v brew >/dev/null 2>&1; then
    if ls "$HOME/Library/Fonts" 2>/dev/null | grep -qi 'jetbrains.*mono.*nerd'; then
      ok "JetBrainsMono Nerd Font already installed."
    else
      info "Installing JetBrainsMono Nerd Font..."
      brew install --cask font-jetbrains-mono-nerd-font
      ok "Font installed."
    fi
  fi

  # Configs
  mkdir -p "$HOME/.config"
  backup_if_exists "$HOME/.wezterm.lua"
  cp "$RESOURCES/wezterm/wezterm.lua" "$HOME/.wezterm.lua"
  ok "Installed ~/.wezterm.lua"
  backup_if_exists "$HOME/.config/starship.toml"
  cp "$RESOURCES/starship/starship.toml" "$HOME/.config/starship.toml"
  ok "Installed ~/.config/starship.toml"

  # Zellij themes (additive — never touches ~/.config/zellij/config.kdl)
  mkdir -p "$HOME/.config/zellij/themes"
  for theme in tokyo-night tokyo-night-day; do
    local dest="$HOME/.config/zellij/themes/${theme}.kdl"
    backup_if_exists "$dest"
    cp "$RESOURCES/zellij/themes/${theme}.kdl" "$dest"
    ok "Installed ~/.config/zellij/themes/${theme}.kdl"
  done
  if command -v zellij >/dev/null 2>&1; then
    ok "Zellij: $(zellij --version)"
  else
    info "Zellij not installed — themes are in place for later (brew install zellij)."
  fi

  # .zshrc managed block
  touch "$ZSHRC"
  if grep -qF "$MARKER_BEGIN" "$ZSHRC"; then
    info "Refreshing existing tokyo-night-shell block in ${ZSHRC/#$HOME/~}..."
    awk -v b="$MARKER_BEGIN" -v e="$MARKER_END" '
      $0 ~ b {inblock=1; next}
      $0 ~ e {inblock=0; next}
      !inblock {print}
    ' "$ZSHRC" > "${ZSHRC}.tmp" && mv "${ZSHRC}.tmp" "$ZSHRC"
  else
    backup_if_exists "$ZSHRC"
  fi
  {
    echo ""
    echo "$MARKER_BEGIN"
    cat "$RESOURCES/shell/zshrc-init.zsh"
    echo "$MARKER_END"
  } >> "$ZSHRC"
  ok "Wired ${ZSHRC/#$HOME/~}"

  echo
  ok "Init complete."
  echo
  echo "  Next:"
  echo "    1. Open a fresh WezTerm window (or 'exec zsh' in this one)."
  echo "    2. Toggle System Settings → Appearance to see the live theme swap."
  echo
  echo "  To remove later:  tokyo-night-shell uninstall"
}

# ─── cmd: uninstall ──────────────────────────────────────────────────────────
cmd_uninstall() {
  restore_latest_backup "$HOME/.wezterm.lua"
  restore_latest_backup "$HOME/.config/starship.toml"

  if [[ -f "$ZSHRC" ]] && grep -qF "$MARKER_BEGIN" "$ZSHRC"; then
    awk -v b="$MARKER_BEGIN" -v e="$MARKER_END" '
      $0 ~ b {inblock=1; next}
      $0 ~ e {inblock=0; next}
      !inblock {print}
    ' "$ZSHRC" > "${ZSHRC}.tmp" && mv "${ZSHRC}.tmp" "$ZSHRC"
    ok "Removed managed block from ${ZSHRC/#$HOME/~}"
  fi

  rm -f "$HOME/.cache/starship-tokyo_night.toml" \
        "$HOME/.cache/starship-tokyo_night_day.toml"
  ok "Cleared starship caches."

  rm -f "$HOME/.config/zellij/themes/tokyo-night.kdl" \
        "$HOME/.config/zellij/themes/tokyo-night-day.kdl" \
        "$HOME/.cache/zellij-tokyo-night.kdl" \
        "$HOME/.cache/zellij-tokyo-night-day.kdl"
  ok "Removed zellij themes and caches."

  echo
  ok "Uninstall complete. Open a new shell to drop the hook."
}

# ─── cmd: swap ───────────────────────────────────────────────────────────────
# Worker helpers — defined at script scope so swap doesn't redefine them on
# every call. They read $color, $DARK, $DAY from cmd_swap's locals via the
# function-call inheritance scope (bash dynamic scoping).
_swap_wezterm() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local mode; mode=$(_mode "$f")
  sed -E "s/(local ACCENT_NAME = ')[a-z]+(')/\\1${color}\\2/" "$f" > "$f.tmp" \
    && mv "$f.tmp" "$f" && chmod "$mode" "$f"
  ok "WezTerm:  ${f/#$HOME/~}"
}
_swap_starship() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  local mode; mode=$(_mode "$f")
  awk -v dark="$DARK" -v day="$DAY" '
    /^\[palettes\.tokyo_night\][[:space:]]*$/     { p = "dark"; print; next }
    /^\[palettes\.tokyo_night_day\][[:space:]]*$/ { p = "day";  print; next }
    /^accent[[:space:]]*=/ {
      if (p == "dark")     { sub(/"[^"]*"/, "\"" dark "\"") }
      else if (p == "day") { sub(/"[^"]*"/, "\"" day "\"") }
    }
    { print }
  ' "$f" > "$f.tmp" && mv "$f.tmp" "$f" && chmod "$mode" "$f"
  ok "Starship: ${f/#$HOME/~}"
}
_swap_zellij() {
  local f="$1" hex="$2"
  [[ -f "$f" ]] || return 0
  local mode; mode=$(_mode "$f")
  awk -v hex="$hex" '
    /^[[:space:]]*ribbon_selected[[:space:]]*\{/ { in_ribbon = 1 }
    /^[[:space:]]*frame_selected[[:space:]]*\{/  { in_frame  = 1 }
    /^[[:space:]]*\}/                            { in_ribbon = 0; in_frame = 0 }
    in_ribbon && /^[[:space:]]*background[[:space:]]+"/ { sub(/"[^"]*"/, "\"" hex "\"") }
    in_frame  && /^[[:space:]]*base[[:space:]]+"/       { sub(/"[^"]*"/, "\"" hex "\"") }
    { print }
  ' "$f" > "$f.tmp" && mv "$f.tmp" "$f" && chmod "$mode" "$f"
  ok "Zellij:   ${f/#$HOME/~}"
}

_swap_usage() {
  cat >&2 <<EOF
Usage: tokyo-night-shell swap [--repo] <color>

Swaps the focus accent (prompt ❯, WezTerm active tab, Zellij active ribbon
and pane border). Edits only installed configs by default.

  blue     #7aa2f7 / #1f5fcc   (default)
  cyan     #7dcfff / #005d7a
  magenta  #bb9af7 / #6a1fbf
  green    #9ece6a / #3d5520
  yellow   #e0af68 / #5f4419
  red      #f7768e / #c80f4a
  orange   #ff9e64 / #8a4400
EOF
  if in_git_clone; then
    cat >&2 <<EOF

  --repo   Also rewrite the repo source files (for forks / upstream PRs).
EOF
  fi
  exit 1
}

cmd_swap() {
  local edit_repo=false color=""
  for arg in "$@"; do
    case "$arg" in
      --repo)
        in_git_clone || fail "--repo not available in brew install (fork the tap to change defaults)"
        edit_repo=true ;;
      -h|--help) _swap_usage ;;
      -*)        fail "Unknown flag: $arg" ;;
      *)
        [[ -n "$color" ]] && fail "Multiple colors given: $color and $arg"
        color="$arg" ;;
    esac
  done
  [[ -n "$color" ]] || _swap_usage

  local DARK="" DAY=""
  case "$color" in
    blue)    DARK="#7aa2f7"; DAY="#1f5fcc" ;;
    cyan)    DARK="#7dcfff"; DAY="#005d7a" ;;
    magenta) DARK="#bb9af7"; DAY="#6a1fbf" ;;
    green)   DARK="#9ece6a"; DAY="#3d5520" ;;
    yellow)  DARK="#e0af68"; DAY="#5f4419" ;;
    red)     DARK="#f7768e"; DAY="#c80f4a" ;;
    orange)  DARK="#ff9e64"; DAY="#8a4400" ;;
    *)       fail "Unknown color: $color (run 'tokyo-night-shell swap' for the list)" ;;
  esac

  echo "Swapping accent → ${color} (dark ${DARK}, day ${DAY})"
  echo

  if $edit_repo; then
    info "Repo source"
    _swap_wezterm  "$RESOURCES/wezterm/wezterm.lua"
    _swap_starship "$RESOURCES/starship/starship.toml"
    _swap_zellij   "$RESOURCES/zellij/themes/tokyo-night.kdl"     "$DARK"
    _swap_zellij   "$RESOURCES/zellij/themes/tokyo-night-day.kdl" "$DAY"
    echo
  fi

  info "Installed configs"
  _swap_wezterm  "$HOME/.wezterm.lua"
  _swap_starship "$HOME/.config/starship.toml"
  _swap_zellij   "$HOME/.config/zellij/themes/tokyo-night.kdl"     "$DARK"
  _swap_zellij   "$HOME/.config/zellij/themes/tokyo-night-day.kdl" "$DAY"

  echo
  echo "Applied. Effects:"
  echo "  • WezTerm  — reloads live (any open window)"
  echo "  • Starship — refreshes on the next prompt (cache regen via mtime)"
  echo "  • Zellij   — restart sessions to apply:  zellij ka && zellij"

  if in_git_clone && ! $edit_repo; then
    echo
    echo "  Note: repo source unchanged. Re-running 'tokyo-night-shell init' would"
    echo "  revert your installed configs to the repo's accent. Pass --repo to also"
    echo "  rewrite the source (for a fork or upstream PR)."
  fi
}

# ─── Dispatch ────────────────────────────────────────────────────────────────
usage() {
  cat <<EOF
tokyo-night-shell — coordinated Tokyo Night theme for WezTerm, Starship, Zellij.

Usage:
  tokyo-night-shell init               Install configs into \$HOME, wire ~/.zshrc.
  tokyo-night-shell uninstall          Restore backups, remove the .zshrc block.
  tokyo-night-shell swap <color>       Swap the focus accent. Run with no color for the list.
  tokyo-night-shell --version
  tokyo-night-shell --help

Resources: $RESOURCES
EOF
}

case "${1:-}" in
  init)             shift; cmd_init "$@" ;;
  uninstall)        shift; cmd_uninstall "$@" ;;
  swap)             shift; cmd_swap "$@" ;;
  -v|--version)     echo "$VERSION" ;;
  -h|--help|"")     usage ;;
  *)                fail "Unknown command: $1 (try 'tokyo-night-shell --help')" ;;
esac
